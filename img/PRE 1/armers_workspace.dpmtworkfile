            "_t": 0,
            "_d": "advancement revoke @s only arms:glass_arms_trigger_adv\n# 请勿删除此行\neffect give @n arms:glass_but 60 2",
            "_filename_id": "glass_arms_trigger_exe"
          },
          {
            "_t": 0,
            "_d": "",
            "_filename_id": "tick"
          },
          {
            "_t": 0,
            "_d": "",
            "_filename_id": "load"
          },
          {
            "_t": 0,
            "_d": "advancement revoke @s only arms:aac_trigger_adv\n# 请勿删除此行\ndamage @s 0.5\nattribute @s minecraft:movement_speed base set 0.5",
            "_filename_id": "aac_trigger_exe"
          },
          {
            "_t": 0,
            "_d": "\ndamage @s 0.5\n",
            "_filename_id": "heath_down_start"
          },
          {
            "_t": 0,
            "_d": "\n\n",
            "_filename_id": "heath_down_tick"
          },
          {
            "_t": 0,
            "_d": "\n\n",
            "_filename_id": "heath_down_remove"
          },
          {
            "_t": 0,
            "_d": "\nexecute if predicate {\"condition\":\"minecraft:random_chance\",\"chance\":0.05} run give @s minecraft:diamond 32\nexecute if predicate {\"condition\":\"minecraft:random_chance\",\"chance\":0.25} run give @s minecraft:gold_ingot 32\nexecute if predicate {\"condition\":\"minecraft:random_chance\",\"chance\":0.3} run give @s minecraft:emerald 32\nexecute if predicate {\"condition\":\"minecraft:random_chance\",\"chance\":0.4} run give @s minecraft:iron_ingot 32\n",
            "_filename_id": "chouj_start"
          },
          {
            "_t": 0,
            "_d": "\nexecute if predicate {\"condition\":\"minecraft:random_chance\",\"chance\":0.1} run give @s minecraft:enchanted_golden_apple 2\nexecute if predicate {\"condition\":\"minecraft:random_chance\",\"chance\":0.9} run give @s minecraft:golden_apple 2\n",
            "_filename_id": "chouj_tick"
          },
          {
            "_t": 0,
            "_d": "\ngive @s minecraft:netherite_upgrade_smithing_template 64\ngive @s minecraft:netherite_ingot 64\n",
            "_filename_id": "chouj_remove"
          },
          {
            "_t": 0,
            "_d": "\ngamemode creative @s\n",
            "_filename_id": "create_start"
          },
          {
            "_t": 0,
            "_d": "\ngive @s minecraft:bedrock 1\n",
            "_filename_id": "create_tick"
          },
          {
            "_t": 0,
            "_d": "\ngamemode survival @s\n",
            "_filename_id": "create_remove"
          }
        ],
